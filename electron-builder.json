{
  "productName": "strawberry-jam",
  "electronVersion": "32.0.1",
  "directories": {
    "output": "build"
  },
  "win": {
    "icon": "./assets/images/icon.ico",
    "asar": true,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "icon": "./assets/images/icon.png",
    "asar": true,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.games",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "linux": {
    "icon": "./assets/images/icon.png",
    "asar": true,
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Game",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "allowElevation": false,
    "installerIcon": "./assets/images/icon.ico",
    "uninstallerIcon": "./assets/images/icon.ico",
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Strawberry Jam",
    "include": "build/installer.nsh",
    "warningsAsErrors": false,
    "guid": "a2f8d7c4-6f3b-4c9e-9a2b-1c8f9e4d7a3c"
  },
  "dmg": {
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "files": [
    "**/*",
    "!**/*.{md,txt,pdf,docx}",
    "!dev/**/*",
    "!build/**/*",
    "!scripts/**/*",
    "!plugins/**/*",
    "!assets/client/**/*",
    "!*.{eslintignore,eslintrc,gitignore,gitattributes,editorconfig}"
  ],
  "extraFiles": [
    "settings.json"
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets",
      "filter": [
        "**/*",
        "!memory-bank/**/*",
        "!client/**/*",
        "!*-backup.asar",
        "!*-dev.asar",
        "!winapp.asar",
        "!osxapp.asar",
        "!**/*.bak",
        "!**/*-backup*",
        "!**/*.tmp",
        "!**/*-copy*",
        "!**/temp_*",
        "!**/tmp_*"
      ]
    },
    {
      "from": "src/electron/clear-cache-helper.js",
      "to": "clear-cache-helper.js"
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "glvckoma",
    "repo": "Strawberry-Jam",
    "releaseType": "release"
  }
}
